<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" 
	xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.plate.launcher.preferences.PreferenceHeader
		android:key="lw_open_gallery"
		android:icon="@drawable/ic_movie"
		android:title="@string/lw_section_title" />

    <com.plate.launcher.preferences.PreferenceHeader
		android:icon="@drawable/ic_appearance"
		android:title="@string/appearance" 
		app:fragment="com.plate.launcher.fragments.AppearancePreferences" />
    

    <com.plate.launcher.preferences.PreferenceHeader
		android:icon="@drawable/ic_apps_menu" 
		app:fragment="com.plate.launcher.fragments.AppMenuPreferences" 
		android:title="@string/app_menu"  />
	<com.plate.launcher.preferences.PreferenceHeader
        android:icon="@drawable/ic_dock"
        android:fragment="com.plate.launcher.fragments.DockPreferences"
        android:title="@string/dock" />
    <com.plate.launcher.preferences.PreferenceHeader
        android:icon="@drawable/ic_star"
        android:fragment="com.plate.launcher.fragments.DefaultAppsPreferences"
        android:title="@string/default_apps" />
    <com.plate.launcher.preferences.PreferenceHeader
        android:icon="@drawable/ic_keyboard"
        android:fragment="com.plate.launcher.fragments.KeyboardPreferences"
        android:title="@string/keyboard" />
	<com.plate.launcher.preferences.PreferenceHeader
        android:icon="@drawable/ic_corners"
        android:fragment="com.plate.launcher.fragments.HotCornersPreferences"
        android:title="@string/hot_corners" />
	<com.plate.launcher.preferences.PreferenceHeader
        android:icon="@drawable/ic_notifications"
        android:fragment="com.plate.launcher.fragments.NotificationPreferences"
        android:title="@string/notifications" />
    <com.plate.launcher.preferences.PreferenceHeader
        android:icon="@drawable/ic_sounds"
        android:fragment="com.plate.launcher.fragments.SoundsPreferences"
        android:title="@string/sounds" />
    <com.plate.launcher.preferences.PreferenceHeader
        android:icon="@drawable/ic_user"
        app:fragment="com.plate.launcher.fragments.MultiUserFragment"
        android:title="@string/multi_user" />
    <com.plate.launcher.preferences.PreferenceHeader
        android:icon="@drawable/ic_plugin"
        app:fragment="com.plate.launcher.fragments.PluginsFragment"
        android:title="@string/plugins" />
    <com.plate.launcher.preferences.PreferenceHeader
        android:icon="@drawable/ic_advanced"
        android:fragment="com.plate.launcher.fragments.AdvancedPreferences"
        android:title="@string/advanced" />
    <!-- Hidden until Developer Mode is unlocked (7 taps on the version
         number in Help & About — see HelpAboutPreferences.handleVersionTap).
         Visibility toggled in PreferencesFragment.refreshBetaVisibility(),
         which reads the same "developer_mode_enabled" flag that unlock
         sets. -->
    <com.plate.launcher.preferences.PreferenceHeader
        android:key="beta_preview"
        android:icon="@drawable/ic_beta"
        android:fragment="com.plate.launcher.fragments.BetaPreferences"
        android:title="@string/beta"
        app:isPreferenceVisible="false" />
    <com.plate.launcher.preferences.PreferenceHeader
        android:icon="@drawable/ic_info"
        android:fragment="com.plate.launcher.fragments.HelpAboutPreferences"
        android:title="@string/help_and_about" />

</PreferenceScreen>