<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="@string/look_and_feel">

        <!-- Custom Font — مدمج هنا بدلاً من قسم منفصل -->
        <Preference
            android:key="custom_font"
            android:title="@string/plugin_font"
            android:summary="@string/plugin_font_none" />

        <!-- Bubble color mode: Material You (auto) or Custom -->
        <ListPreference
            android:defaultValue="custom"
            android:entries="@array/bubble_modes"
            android:entryValues="@array/bubble_mode_values"
            android:key="bubble_mode"
            android:title="@string/bubble_mode_title"
            android:summary="@string/bubble_mode_summary" />

        <!-- Custom bubble controls — visible only when bubble_mode = custom -->
        <Preference
            android:key="bubble_color_picker"
            android:title="@string/bubble_color_title"
            android:summary="@string/bubble_color_summary" />

        <!-- Bubble opacity — يظهر دائماً لكلا الوضعين -->
        <Preference
            android:key="bubble_opacity_picker"
            android:title="@string/bubble_opacity_title"
            android:summary="@string/bubble_opacity_summary" />

        <ListPreference
            android:defaultValue="material_u"
            android:entries="@array/themes"
            android:entryValues="@array/theme_values"
            android:key="theme"
            android:title="@string/theme_title" />


        <Preference
            android:key="theme_main_color"
            android:summary="@string/theme_main_color_summary"
            android:title="@string/theme_main_color_title" />

        <!-- 1.15: Override Dock Background Transparency -->
        <SwitchPreferenceCompat
            android:key="override_dock_background_alpha"
            android:title="@string/override_dock_background_opacity"
            android:defaultValue="false" />

        <com.youki.dex.preferences.SliderPreference
            android:key="dock_background_alpha"
            android:title="@string/dock_background_opacity"
            android:defaultValue="255"
            android:dependency="override_dock_background_alpha" />

        <!-- App Dock (Icons) Background & Opacity -->
        <SwitchPreferenceCompat
            android:key="enable_app_dock_bg"
            android:title="@string/enable_app_dock_bg_title"
            android:summary="@string/enable_app_dock_bg_summary"
            android:defaultValue="true" />

        <com.youki.dex.preferences.SliderPreference
            android:key="app_dock_bg_opacity"
            android:title="@string/app_dock_bg_opacity_title"
            android:defaultValue="115"
            android:dependency="enable_app_dock_bg" />

        <!-- App Drawer Background Opacity -->
        <com.youki.dex.preferences.SliderPreference
            android:key="app_menu_opacity"
            android:title="@string/app_menu_opacity_title"
            android:defaultValue="230" />

        <Preference
            android:key="dock_layout"
            android:title="@string/dock_layout" />

        <ListPreference
            android:defaultValue="circle"
            android:entries="@array/icon_shapes"
            android:entryValues="@array/icon_shapes_values"
            android:key="icon_shape"
            android:title="@string/icon_shape_title" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="round_dock"
            android:title="@string/round_dock" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="single_line_labels"
            android:title="@string/single_line_labels" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="tint_indicators"
            android:title="@string/tint_indicators_title" />

        <!-- تكبير/تصغير حجم الأيقونات (Dock + شاشة التطبيقات) -->
        <com.youki.dex.preferences.SliderPreference
            android:key="icon_scale_percent"
            android:title="@string/icon_scale_title"
            android:summary="@string/icon_scale_summary" />

        <!-- تكبير/تصغير حجم الخط (أسماء التطبيقات وشارات العداد فقط — الدوك/الشبكة) -->
        <com.youki.dex.preferences.SliderPreference
            android:key="label_font_scale_percent"
            android:title="@string/label_font_scale_title"
            android:summary="@string/label_font_scale_summary" />

        <!-- 🆕 تكبير/تصغير حجم الخط على كل التطبيق (الإعدادات، الورك شوب، الدوك،
             القوائم...) — مستقل عن label_font_scale_percent أعلاه الذي يخص فقط
             حجم اسم التطبيق تحت الأيقونة. انظر AppFontScaleUtils للتفاصيل
             التقنية الكاملة لكيفية تطبيقه على كل من الشاشات والدوك معاً. -->
        <com.youki.dex.preferences.SliderPreference
            android:key="app_font_scale_percent"
            android:title="@string/app_font_scale_title"
            android:summary="@string/app_font_scale_summary" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/custom_badge_category">

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="custom_badge_enabled"
            android:title="@string/custom_badge_enabled_title"
            android:summary="@string/custom_badge_enabled_summary" />

        <Preference
            android:key="custom_badge_text"
            android:title="@string/custom_badge_text_title"
            android:summary="@string/custom_badge_text_summary"
            android:dependency="custom_badge_enabled" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/behaviour">
        <SwitchPreferenceCompat
            android:key="lock_landscape"
            android:title="@string/lock_landscape_title"
            android:summary="@string/lock_landscape_summary"
            android:defaultValue="true" />
        <!-- GitHub issue #21: hiding the status/nav bar in desktop mode used
             to be unconditional with no way to opt out. Default true keeps
             existing users' behavior unchanged. -->
        <SwitchPreferenceCompat
            android:key="hide_system_bars"
            android:title="@string/hide_system_bars_title"
            android:summary="@string/hide_system_bars_summary"
            android:defaultValue="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/desktop">
        <Preference
            android:key="desktop_res_value"
            android:title="@string/desktop_res_value_title"
            android:summary="@string/desktop_res_value_summary" />
    </PreferenceCategory>

</PreferenceScreen>
