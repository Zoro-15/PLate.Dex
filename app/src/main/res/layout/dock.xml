<com.youki.dex.widgets.HoverInterceptorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:elevation="5dp">

    <RelativeLayout
        android:id="@+id/dock_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/round_rect"
        android:paddingStart="5dp"
        android:paddingEnd="10dp"
        android:visibility="gone">

        <!-- CENTER: running apps -->
        <LinearLayout
            android:id="@+id/center_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/apps_btn_center"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="4dp"
                android:src="@drawable/ic_apps_menu"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/apps_lv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fadingEdgeLength="6dp"
                android:requiresFadingEdge="horizontal" />
        </LinearLayout>

        <!-- RIGHT: system tray — SmartDock style -->
        <LinearLayout
            android:id="@+id/system_tray"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Dedicated Pin Pill -->
            <LinearLayout
                android:id="@+id/pin_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:background="@drawable/btn_bubble_rect"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/pin_btn"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_margin="3dp"
                    android:background="@null"
                    android:padding="6dp"
                    android:src="@drawable/ic_unpin" />

                <ImageView
                    android:id="@+id/hide_pills_btn"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_margin="3dp"
                    android:background="@null"
                    android:padding="6dp"
                    android:tint="#FFFFFFFF"
                    android:src="@drawable/ic_visibility" />
            </LinearLayout>

            <!-- Status area bubble: notifications + volume + bt + wifi + battery -->
            <LinearLayout
                android:id="@+id/status_area"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:background="@drawable/btn_bubble_rect"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/notifications_btn"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_margin="3dp"
                    android:background="@drawable/ic_expand_up_circle"
                    android:gravity="center"
                    android:padding="2dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="10sp" />

                <ImageView
                    android:id="@+id/volume_btn"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_margin="3dp"
                    android:src="@drawable/ic_volume"
                    android:tint="#FFFFFFFF" />

                <ImageView
                    android:id="@+id/bluetooth_btn"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_margin="3dp"
                    android:src="@drawable/ic_bluetooth_off"
                    android:tint="#FFFFFFFF"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/wifi_btn"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_margin="3dp"
                    android:src="@drawable/ic_wifi_on"
                    android:tint="#FFFFFFFF" />

                <TextView
                    android:id="@+id/battery_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_margin="3dp"
                    android:gravity="center_vertical"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/resource_monitor_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_margin="3dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:visibility="gone"
                    android:text="0% 0M" />

            </LinearLayout>

            <!-- Clock — no action on click -->
            <TextClock
                android:id="@+id/date_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- LEFT: nav panel -->
        <LinearLayout
            android:id="@+id/nav_panel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/apps_btn"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_margin="3dp"
                android:background="@null"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true"
                android:tint="#FFFFFFFF"
                android:src="@drawable/ic_apps_menu" />

            <!-- FIX: action buttons merged into one pill (wallpaper + cast) -->
            <LinearLayout
                android:id="@+id/action_btns_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:background="@drawable/btn_bubble_rect"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <ImageView
                    android:id="@+id/user_btn"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_margin="2dp"
                    android:background="@null"
                    android:padding="0dp"
                    android:src="@drawable/ic_user"
                    android:tint="#FFFFFFFF"
                    android:scaleType="centerCrop"
                    android:clickable="true"
                    android:focusable="true" />

                <ImageView
                    android:id="@+id/wallpaper_btn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_margin="2dp"
                    android:background="@null"
                    android:padding="4dp"
                    android:src="@drawable/ic_wallpaper"
                    android:clickable="true"
                    android:focusable="true" />

                <ImageView
                    android:id="@+id/cast_btn"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_margin="2dp"
                    android:background="@null"
                    android:padding="4dp"
                    android:src="@drawable/ic_screen"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- FIX: nav buttons merged into one pill (back + home + recents + assist) -->
            <LinearLayout
                android:id="@+id/nav_btns_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="3dp"
                android:background="@drawable/btn_bubble_rect"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <ImageView
                    android:id="@+id/back_btn"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_margin="2dp"
                    android:background="@null"
                    android:padding="9dp"
                    android:src="@drawable/ic_back"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/home_btn"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_margin="2dp"
                    android:background="@null"
                    android:padding="9dp"
                    android:src="@drawable/ic_home" />

                <ImageView
                    android:id="@+id/recents_btn"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_margin="2dp"
                    android:background="@null"
                    android:padding="9dp"
                    android:src="@drawable/ic_recents" />

                <ImageView
                    android:id="@+id/assist_btn"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_margin="2dp"
                    android:background="@null"
                    android:padding="8dp"
                    android:src="@drawable/ic_assistant"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>

</com.youki.dex.widgets.HoverInterceptorLayout>
