<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pill_time_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_datetime_container"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="2dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <!-- The Date Text Styling -->
    <TextClock
        android:id="@+id/pill_date_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="6dp"
        android:textColor="#FFFFFF"
        android:textSize="11.5sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.02"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:gravity="center"
        android:format12Hour="EEE, dd/MM"
        android:format24Hour="EEE, dd/MM" />

    <!-- Translates from bg_time_pill.xml and the Time TextView -->
    <TextClock
        android:id="@+id/pill_time_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:background="@drawable/bg_time_pill"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:textColor="#222222"
        android:textSize="11.5sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.02"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:gravity="center" />
</LinearLayout>
