<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/task_tile_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_marginTop="12dp"
    android:layout_marginEnd="10dp"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <!-- Preview Card Window -->
    <FrameLayout
        android:id="@+id/task_card_window"
        android:layout_width="200dp"
        android:layout_height="124dp"
        android:background="@drawable/bg_task_preview_card"
        android:clipToOutline="true"
        android:elevation="6dp">

        <!-- Central preview icon / snapshot -->
        <ImageView
            android:id="@+id/task_tile_preview_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter" />

        <!-- Optional Task Snapshot image if available -->
        <ImageView
            android:id="@+id/task_tile_snapshot_iv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <!-- Top Right Close Circular Button -->
        <FrameLayout
            android:id="@+id/task_tile_close_btn"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="top|end"
            android:layout_margin="7dp"
            android:background="@drawable/bg_task_close_circle"
            android:clickable="true"
            android:contentDescription="@string/close"
            android:elevation="4dp"
            android:focusable="true">

            <ImageView
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_close" />
        </FrameLayout>
    </FrameLayout>

    <!-- Circular App Icon Badge Centered Beneath Preview Window -->
    <FrameLayout
        android:id="@+id/task_icon_badge_container"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_task_icon_circle"
        android:clickable="true"
        android:elevation="4dp"
        android:focusable="true">

        <ImageView
            android:id="@+id/task_tile_badge_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter" />
    </FrameLayout>

</LinearLayout>
