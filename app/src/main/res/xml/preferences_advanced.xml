<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <Preference
        android:icon="@drawable/ic_info"
        android:title="@string/these_settings_are_intended_fo" />

    <!-- FIX: صلاحية الإشعارات — يفتح الصفحة الصحيحة مباشرةً -->
    <Preference
        android:key="notification_listener_permission"
        android:icon="@drawable/ic_notifications"
        android:title="@string/manage_service"
        android:summary="@string/notification_listener_access" />

    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:key="prefer_last_display"
        android:summary="@string/prefer_last_display_summary"
        android:title="@string/prefer_last_display" />

    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:key="custom_toasts"
        android:summary="@string/custom_toasts_summary"
        android:title="@string/custom_toasts" />

    <com.youki.dex.preferences.SliderPreference
        android:defaultValue="48"
        android:key="dock_height"
        android:title="@string/dock_height" />

    <com.youki.dex.preferences.IconPackPreference
        android:key="icon_pack"
        android:title="@string/icon_pack" />

    <!-- ══ Quick Settings Panel customization ══════════════════════════ -->
    <PreferenceCategory
        android:key="qs_panel_category"
        android:title="@string/qs_panel_tiles_title"
        android:summary="@string/qs_panel_tiles_summary">

        <ListPreference
            android:defaultValue="wifi"
            android:entries="@array/qs_panel_tile_types"
            android:entryValues="@array/qs_panel_tile_type_values"
            android:key="qs_panel_tile_1"
            android:title="@string/qs_panel_tile_1_title" />

        <ListPreference
            android:defaultValue="bluetooth"
            android:entries="@array/qs_panel_tile_types"
            android:entryValues="@array/qs_panel_tile_type_values"
            android:key="qs_panel_tile_2"
            android:title="@string/qs_panel_tile_2_title" />

        <ListPreference
            android:defaultValue="none"
            android:entries="@array/qs_panel_tile_types"
            android:entryValues="@array/qs_panel_tile_type_values"
            android:key="qs_panel_tile_3"
            android:title="@string/qs_panel_tile_3_title" />

        <ListPreference
            android:defaultValue="none"
            android:entries="@array/qs_panel_tile_types"
            android:entryValues="@array/qs_panel_tile_type_values"
            android:key="qs_panel_tile_4"
            android:title="@string/qs_panel_tile_4_title" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="enable_qs_bottom_row"
            android:summary="@string/enable_qs_bottom_row_summary"
            android:title="@string/enable_qs_bottom_row_title" />

    </PreferenceCategory>

    <!-- ══ Workshop Sources ══════════════════════════════════════════════ -->
    <PreferenceCategory
        android:key="workshop_sources_category"
        android:title="@string/workshop_sources">

        <Preference
            android:key="manage_workshop_sources"
            android:title="@string/manage_sources"
            android:summary="@string/manage_workshop_sources_summary" />

    </PreferenceCategory>

    <PreferenceCategory
        android:enabled="false"
        android:key="secure_category"
        android:title="@string/secure_settings">

        <Preference
            android:key="custom_display_size"
            android:summary="@string/custom_display_size_summary"
            android:title="@string/custom_display_size_title" />

        <Preference
            android:key="custom_display_resolution"
            android:summary="@string/custom_display_resolution_title"
            android:title="@string/custom_display_resolution_title" />

        <Preference
            android:key="status_icon_blacklist"
            android:summary="@string/icon_blacklist_summary"
            android:title="@string/icon_blacklist" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="disable_heads_up"
            android:summary="@string/disable_heads_up_summary"
            android:title="@string/disable_heads_up" />

        <SwitchPreferenceCompat
            android:key="hide_status_bar"
            android:summary="@string/hide_status_bar_summary"
            android:title="@string/hide_status_bar_title"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="hide_nav_buttons"
            android:summary="@string/hide_nav_buttons_summary"
            android:title="@string/hide_nav_buttons_title"
            android:defaultValue="false" />

    </PreferenceCategory>



    <PreferenceCategory
        android:key="root_category"
        android:title="@string/root_required">

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="enable_power_menu"
            android:summary="@string/enable_power_menu_summary"
            android:title="@string/enable_power_menu_title" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="allow_app_freeze"
            android:summary="@string/allow_app_freeze_summary"
            android:title="@string/allow_app_freeze_title" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="allow_sysapp_uninstall"
            android:summary="@string/allow_sysapp_uninstall_summary"
            android:title="@string/allow_sysapp_uninstall_title" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="disable_taskbar"
            android:summary="@string/disable_taskbar_summary"
            android:title="@string/disable_taskbar_title"
            app:isPreferenceVisible="false" />




        <SwitchPreferenceCompat
            android:key="enable_tiling"
            android:title="@string/enable_tiling_shortcut"
            android:defaultValue="true" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="enable_soft_reboot"
            android:summary="@string/enable_soft_reboot_summary"
            android:title="@string/enable_soft_reboot_title" />

        <Preference
            android:key="soft_reboot"
            android:summary="@string/soft_reboot_summary"
            android:title="@string/soft_reboot_title" />
    </PreferenceCategory>
    <PreferenceCategory
        android:key="backup_category"
        android:title="@string/backup_restore">

        <Preference
            android:key="backup_preferences"
            android:title="@string/backup_preferences" />
        <Preference
            android:key="restore_preferences"
            android:title="@string/restore_preferences" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="editor_category"
        android:title="@string/editor_category_title">

        <EditTextPreference
            android:key="editor_preview_scale"
            android:defaultValue="65"
            android:hint="65"
            android:title="@string/editor_preview_scale_title"
            android:summary="@string/editor_preview_scale_summary" />

        <!-- Aspect ratio for the preview in EditorActivity.
             "auto"  = reads actual screen ratio automatically
             "16_9"  = classic 16:9 (default)
             "4_3"   = 4:3
             "9_16"  = 9:16 portrait video -->
        <ListPreference
            android:key="editor_preview_aspect"
            android:defaultValue="16_9"
            android:title="@string/editor_preview_aspect_title"
            android:summary="@string/editor_preview_aspect_summary"
            android:entries="@array/editor_preview_aspect_entries"
            android:entryValues="@array/editor_preview_aspect_values" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="development_category"
        android:title="@string/development_tools">

        <EditTextPreference
            android:defaultValue="1.0"
            android:hint="1.0"
            android:key="scale_factor"
            android:summary="@string/scale_factor_summary"
            android:title="@string/scale_factor_title" />

        <EditTextPreference
            android:defaultValue="5"
            android:hint="5"
            android:key="icon_padding"
            android:summary="@string/icon_padding_summary"
            android:title="@string/icon_padding_title" />

        <Preference
            android:key="share_display_info"
            android:title="@string/share_display_info"/>

    </PreferenceCategory>

    <!-- OTG / UHID mode — phone acts as USB keyboard+mouse for a connected PC -->
    <PreferenceCategory android:title="@string/uhid_category_title">

        <SwitchPreferenceCompat
            android:key="uhid_mode_enabled"
            android:title="@string/uhid_mode_title"
            android:summary="@string/uhid_mode_summary"
            android:defaultValue="false" />

        <Preference
            android:key="uhid_open_trackpad"
            android:title="@string/uhid_open_trackpad"
            android:summary="@string/uhid_open_trackpad_summary" />

    </PreferenceCategory>

</PreferenceScreen>
