<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory
        android:title="@string/dock_position_category">
        <Preference
            android:key="dock_position_toggle"
            android:title="@string/dock_position_title"
            android:summary="@string/dock_position_summary" />
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/navigation">
		<SwitchPreferenceCompat
            android:key="enable_nav_apps"
            android:title="@string/enable_apps_btn"
			android:summary="@string/enable_apps_btn_summary"
            android:defaultValue="true" />
        <com.plate.launcher.preferences.NavActionChooserPreference
            android:key="enable_nav_back"
            android:title="@string/enable_nav_back_title"
            android:defaultValue="true" />
        <com.plate.launcher.preferences.NavActionChooserPreference
            android:key="enable_nav_home"
            android:title="@string/enable_nav_home_title"
            android:defaultValue="true" />
        <com.plate.launcher.preferences.NavActionChooserPreference
            android:key="enable_nav_recents"
            android:title="@string/enable_nav_recents_title"
            android:defaultValue="true" />
        <SwitchPreferenceCompat
            android:key="enable_nav_assist"
            android:title="@string/enable_nav_assist_title"
            android:defaultValue="false" />
        <SwitchPreferenceCompat
            android:key="swap_nav_pin"
            android:title="@string/swap_nav_pin_title"
            android:summary="@string/swap_nav_pin_summary"
            android:defaultValue="false" />
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/quick_settings">
		<SwitchPreferenceCompat
			android:title="@string/enable_notif_btn"
			android:key="enable_qs_notif"
			android:defaultValue="false"
			/>
        <SwitchPreferenceCompat
            android:key="enable_qs_bluetooth"
            android:title="@string/enable_qs_bluetooth_title"
            android:defaultValue="false" />
        <SwitchPreferenceCompat
            android:key="enable_qs_battery"
            android:title="@string/enable_qs_battery_title"
            android:defaultValue="false" />
		<SwitchPreferenceCompat
			android:key="show_battery_level"
			android:title="@string/display_battery_level"
			android:dependency="enable_qs_battery"
			android:defaultValue="false" />
        <SwitchPreferenceCompat
            android:key="enable_qs_wifi"
            android:title="@string/enable_qs_wifi_title"
            android:defaultValue="true" />
        <SwitchPreferenceCompat
            android:key="enable_qs_vol"
            android:title="@string/enable_qs_vol_title"
            android:defaultValue="true" />
        <SwitchPreferenceCompat
            android:key="enable_qs_date"
            android:title="@string/enable_qs_date_title"
            android:defaultValue="true" />
        <SwitchPreferenceCompat
            android:key="enable_qs_wallpaper"
            android:title="@string/wallpaper_button"
            android:summary="@string/wallpaper_button_summary"
            android:defaultValue="false" />

        <com.plate.launcher.preferences.AppChooserPreference
            android:key="app_wallpaper"
            android:title="@string/wallpaper_app"
            android:summary="@string/wallpaper_app_summary"
            android:dependency="enable_qs_wallpaper"
            android:defaultValue="" />

        <SwitchPreferenceCompat
            android:key="enable_qs_pin"
            android:title="@string/enable_qs_pin_title"
            android:summary="@string/enable_qs_pin_summary"
            android:defaultValue="true" />

        <SwitchPreferenceCompat
            android:key="enable_qs_user"
            android:title="@string/enable_user_btn"
            android:summary="@string/enable_user_btn_summary"
            android:defaultValue="true" />

    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/behaviour">
		<ListPreference
			android:summary="@string/activation_method_summary"
			android:entries="@array/activation_methods" 
            android:title="@string/activation_method" 
            android:entryValues="@array/activation_method_values" 
            android:key="activation_method"
            android:defaultValue="swipe" />
        <SwitchPreferenceCompat
            android:key="dock_hover_show_hide"
            android:title="@string/dock_hover_show_hide_title"
            android:summary="@string/dock_hover_show_hide_summary"
            android:defaultValue="true" />
		
		<com.plate.launcher.preferences.SliderPreference
		    android:inputType="number"
			android:key="handle_opacity"
			android:defaultValue="0.5"
			android:title="@string/handle_opacity"/>

		<ListPreference
			android:entries="@array/handle_positions"
			android:entryValues="@array/handle_positions_values"
			android:key="handle_position"
			android:defaultValue="start"
			android:title="@string/handle_position"/>
			
		<com.plate.launcher.preferences.SliderPreference
			android:key="dock_activation_area"
			android:defaultValue="10"
			android:summary="@string/dock_activation_area_summary"
			android:title="@string/dock_activation_area_title"/>
								
		<Preference
			android:key="auto_pin"
			android:summary="@string/auto_pin_summary"
			android:title="@string/auto_pin_title"/>
        
        <EditTextPreference
            android:key="max_running_apps"
            android:hint="10"
            android:defaultValue="10"
			android:title="@string/max_running_apps_portrait"
			android:summary="@string/running_apps_number_title"/>

		<EditTextPreference
			android:key="max_running_apps_landscape"
			android:hint="10"
			android:defaultValue="10"
			android:title="@string/max_running_apps_landscape"
			android:summary="@string/running_apps_number_title"/>
        
        <SwitchPreferenceCompat
            android:key="center_running_apps"
            android:title="@string/center_running_apps_title"
            android:defaultValue="true" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/behaviour">

        <SwitchPreferenceCompat
            android:key="center_apps_btn"
            android:title="@string/win11_style_center_button"
            android:summary="@string/win11_style_center_button_summary"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="show_running_indicators"
            android:title="@string/show_running_app_dots"
            android:summary="@string/show_running_app_dots_summary"
            android:defaultValue="true" />

        <SwitchPreferenceCompat
            android:key="shizuku_active_app_detection"
            android:title="@string/shizuku_active_app_detection_title"
            android:summary="@string/shizuku_active_app_detection_summary"
            android:defaultValue="false" />
           </PreferenceCategory>

    <PreferenceCategory android:title="@string/quick_settings_panel">
        <SwitchPreferenceCompat
            android:key="always_floating"
            android:title="@string/always_floating_title"
            android:summary="@string/always_floating_summary"
            android:defaultValue="false" />
        <SwitchPreferenceCompat
            android:key="show_resource_monitor"
            android:title="@string/resource_monitor_title"
            android:summary="@string/resource_monitor_summary"
            android:defaultValue="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/appearance">
        <com.plate.launcher.preferences.SliderPreference
            android:defaultValue="48"
            android:key="dock_height"
            android:title="@string/dock_height" />

        <SwitchPreferenceCompat
            android:key="show_search_bar"
            android:title="@string/show_search_bar_title"
            android:summary="@string/show_search_bar_summary"
            android:defaultValue="true" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/status_pills_category">
        <SwitchPreferenceCompat
            android:key="enable_pill_time"
            android:title="@string/enable_pill_time_title"
            android:summary="@string/enable_pill_time_summary"
            android:defaultValue="false" />

        <SwitchPreferenceCompat
            android:key="enable_pill_battery"
            android:title="@string/enable_pill_battery_title"
            android:summary="@string/enable_pill_battery_summary"
            android:defaultValue="false" />

        <com.plate.launcher.preferences.SliderPreference
            android:key="pill_transparency"
            android:title="@string/pill_transparency_title"
            android:defaultValue="0.9" />

        <com.plate.launcher.preferences.SliderPreference
            android:key="pill_height"
            android:title="@string/pill_height_title"
            android:defaultValue="30" />

        <com.plate.launcher.preferences.SliderPreference
            android:key="pill_time_length"
            android:title="@string/pill_time_length_title"
            android:defaultValue="75" />

        <com.plate.launcher.preferences.SliderPreference
            android:key="pill_battery_length"
            android:title="@string/pill_battery_length_title"
            android:defaultValue="90" />

        <com.plate.launcher.preferences.SliderPreference
            android:key="pill_battery_icon_size"
            android:title="@string/pill_battery_icon_size_title"
            android:defaultValue="60" />

        <com.plate.launcher.preferences.SliderPreference
            android:key="pill_text_size"
            android:title="@string/pill_text_size_title"
            android:defaultValue="12" />

        <com.plate.launcher.preferences.SliderPreference
            android:key="pill_text_weight"
            android:title="@string/pill_text_weight_title"
            android:defaultValue="4" />

        <com.plate.launcher.preferences.SliderPreference
            android:key="pill_side_margin"
            android:title="@string/pill_side_margin_title"
            android:defaultValue="4" />
    </PreferenceCategory>

</PreferenceScreen>
